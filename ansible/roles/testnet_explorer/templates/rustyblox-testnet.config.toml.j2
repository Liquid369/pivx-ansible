# RustyBlox testnet6 config — generated by Ansible.
# Second instance on this box; the mainnet instance in /root/rusty-blox is
# untouched. Reuses the same built binary and frontend, own data + port.

[paths]
db_path = "{{ explorer_rustyblox_db_dir }}/blocks.db"
# testnet=1 makes pivxd store chain data under <datadir>/testnet6/
blk_dir = "{{ explorer_pivx_datadir }}/testnet6/blocks"
ldb_dir = "{{ explorer_pivx_datadir }}/testnet6/leveldb"
pivx_data_dir = "{{ explorer_pivx_datadir }}/testnet6"
chainstate_copy_dir = "/tmp/pivx_testnet_chainstate_current"
block_index_copy_dir = "/tmp/pivx_testnet_block_index_current"
blk_copy_dir = ""
frontend_dist = "{{ explorer_rustyblox_frontend_dist }}"

[sync]
resync = false
# Fresh chain: serve as soon as there is data rather than waiting for the
# 1000-block mainnet default.
min_blocks_to_serve = {{ explorer_rustyblox_min_blocks | default(1000) }}
fast_sync = true
enrich_addresses = true
build_utxo = true
use_chainstate_for_utxos = false
use_block_index_for_heights = true
parallel_files = 4
enrich_parallel_shards = 2
live_tail_blkfiles = true
live_analytics = false

[rocksdb]
# testnet is tiny; keep the memory budget modest so the mainnet explorer
# keeps its headroom on this shared box.
write_buffer_size = 64
max_write_buffer_number = 3
min_write_buffer_number_to_merge = 1
block_cache_size = 128
target_file_size_base = 64
max_open_files = 2000
max_background_jobs = 4
max_subcompactions = 2
compression_type = "lz4"
enable_pipelined_write = true
allow_concurrent_memtable_write = true

[rpc]
host = "http://127.0.0.1:{{ explorer_pivx_rpc_port }}"
user = "{{ explorer_pivx_rpc_user }}"
pass = "{{ explorer_pivx_rpc_password }}"

[server]
host = "127.0.0.1"
port = {{ explorer_rustyblox_port }}
worker_threads = "2"
ws_allowed_origins = "https://{{ explorer_domain }}"

[repair]
reresolve_heightless = false
