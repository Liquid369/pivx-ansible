# pivx.conf — testnet6 explorer node on {{ inventory_hostname }}
# Generated by Ansible. Separate from the mainnet node on this box.
testnet=1

[test]
server=1
listen=1
txindex=1
rpcuser={{ explorer_pivx_rpc_user }}
rpcpassword={{ explorer_pivx_rpc_password }}
rpcport={{ explorer_pivx_rpc_port }}
rpcbind=127.0.0.1
rpcallowip=127.0.0.1
port={{ explorer_pivx_p2p_port }}
paramsdir={{ explorer_pivx_params_dir }}

# Bootstrap from the fleet seeders.
{% for seed in pivx_seed_nodes | default([]) %}
addnode={{ seed }}
{% endfor %}

# Explorer is an observer: no mining, staking, or masternode.
gen=0
staking=0
