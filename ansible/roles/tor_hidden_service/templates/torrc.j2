# /etc/tor/torrc
# Generated by Ansible for host: {{ inventory_hostname }}
# Hidden services for the Tor-cohort PIVX instances.

SocksPort {{ tor_socks_port | default(9050) }}
SocksPolicy accept 127.0.0.1
SocksPolicy reject *

# Log to journal
Log notice syslog

# One hidden service per Tor instance, each with its own directory and so its
# own .onion address.
#
# The PUBLIC port is always the network default ({{ pivx_p2p_port_base }}) and is
# forwarded to whatever local port the instance listens on. A masternode
# announcing any other port is rejected outright:
#   masternodeconfig.cpp:89    masternode.conf parse
#   masternode.cpp:368-377     CheckDefaultPort on the broadcast
# Tor is exempt from the "announce the port you bind" rule precisely because
# the hidden service does this mapping (activemasternode.cpp:276-281).
{% for inst in pivx_instances | selectattr('protocol_class', 'equalto', 'tor') | list %}
# {{ inst.name }}  ->  local {{ inst.p2p_port }}
HiddenServiceDir {{ inst.onion_service_dir }}
HiddenServiceVersion 3
HiddenServicePort {{ pivx_p2p_port_base }} 127.0.0.1:{{ inst.p2p_port }}
{% endfor %}
