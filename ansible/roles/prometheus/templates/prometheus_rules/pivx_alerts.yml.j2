# Prometheus alerting rules — PIVX Testnet6
# Generated by Ansible. Covers all lifecycle phases:
#   - Node/host availability
#   - Bootstrap mining phase (Phase 2)
#   - PoS/staking phase (Phase 3)
#   - Masternode/quorum phase (Phase 4)
#
# NOTE: Rules referencing job="pivxd_exporter" are PLACEHOLDERS.
# A custom PIVX process/RPC exporter is needed for those.
# Until then they will always be "no data" and won't fire.
# node_exporter rules (cpu, disk, memory, up) are fully functional now.

groups:

  # ===========================================================================
  # HOST AVAILABILITY
  # ===========================================================================
  - name: host_availability
    interval: 30s
    rules:

      - alert: NodeDown
        expr: up{job="node_exporter"} == 0
        for: 2m
        labels:
          severity: critical
          chain: "{{ chain }}"
        annotations:
          summary: "Host {{ '{{' }} $labels.instance {{ '}}' }} is unreachable"
          description: >
            node_exporter on {{ '{{' }} $labels.instance {{ '}}' }}
            (provider={{ '{{' }} $labels.provider {{ '}}' }}) has been
            unreachable for more than 2 minutes.

      - alert: SeedNodeDown
        expr: up{job="node_exporter", node_role="seeder"} == 0
        for: 2m
        labels:
          severity: critical
          chain: "{{ chain }}"
        annotations:
          summary: "SEED NODE {{ '{{' }} $labels.instance {{ '}}' }} is down"
          description: >
            Seed node {{ '{{' }} $labels.instance {{ '}}' }} has been
            unreachable for >2 minutes. New nodes cannot bootstrap the chain.

      - alert: HighCPU
        expr: 100 - (avg by (instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > 90
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "High CPU on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: "CPU usage exceeds 90% for 10 minutes."

      - alert: HighCPUMiningNode
        # During bootstrap_mining, elevated CPU is expected. Raise threshold.
        expr: |
          100 - (avg by (instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > 98
          and on(instance) node_meta_node_role{role="bootstrap_miner"} == 1
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Miner CPU near 100% on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: "Bootstrap miner CPU at near 100% — expected during active mining, but verify it hasn't stalled."

      - alert: DiskSpaceLow
        expr: |
          (node_filesystem_avail_bytes{mountpoint="/",fstype!="tmpfs"}
           / node_filesystem_size_bytes{mountpoint="/",fstype!="tmpfs"}) * 100 < 15
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Low disk on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: "Root filesystem below 15% free. PIVX datadirs grow continuously."

      - alert: DiskSpaceCritical
        expr: |
          (node_filesystem_avail_bytes{mountpoint="/",fstype!="tmpfs"}
           / node_filesystem_size_bytes{mountpoint="/",fstype!="tmpfs"}) * 100 < 5
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "CRITICAL: Disk nearly full on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: "Root filesystem below 5% free. Instances will crash-loop soon."

      - alert: MemoryLow
        expr: (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100 < 10
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Low memory on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: "Less than 10% RAM available."

  # ===========================================================================
  # PIVX SERVICE STATE
  # Rules below require a custom PIVX exporter. Flagged as PLACEHOLDER.
  # ===========================================================================
  - name: pivx_service
    interval: 60s
    rules:


      # Chain state comes from the pivx_metrics textfile collector, served by
      # node_exporter — there is no separate pivxd_exporter scrape job, so
      # per-instance liveness is the pivxd_up metric rather than `up`.
      - alert: PivxdInstanceDown
        expr: pivxd_up == 0
        for: 3m
        labels:
          severity: critical
        annotations:
          summary: "PIVX instance {{ '{{' }} $labels.pivx_instance {{ '}}' }} is down"
          description: >
            pivxd instance {{ '{{' }} $labels.pivx_instance {{ '}}' }} on
            {{ '{{' }} $labels.host {{ '}}' }}
            (cohort={{ '{{' }} $labels.cohort {{ '}}' }})
            has not answered getblockchaininfo for >3 minutes.

      - alert: PivxMetricsStale
        # Without this, a dead collector looks identical to a healthy fleet:
        # the textfile keeps serving its last values forever.
        expr: time() - pivxd_scrape_timestamp > 300
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Chain metrics stale on {{ '{{' }} $labels.host {{ '}}' }}"
          description: >
            pivx-metrics.timer has not written for >5 minutes, so every chain
            panel for this host is showing stale data.

      - alert: ChainHeightDiverged
        expr: |
          max(pivxd_block_height) - min(pivxd_block_height) > 10
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Chain height divergence across fleet"
          description: >
            >10 blocks between the highest and lowest instance in the fleet.
            Stalled instance, or a network partition.

      - alert: ChainForkDetected
        # Grouped by checkpoint_height so only nodes fingerprinting the SAME
        # block are compared. Without the grouping this fires constantly:
        # nodes a block or two apart during propagation hash different blocks
        # and every propagation looks like a fork.
        #
        # count_values is an aggregation operator and needs its own by clause.
        # Without one it collapses every input series and drops
        # checkpoint_height, so the outer count groups on a label that is no
        # longer there and compares fingerprints taken at different heights.
        # That reported a fork on a fleet agreeing on every block: at 15s PoS
        # spacing nodes straddle a stride boundary constantly, so two
        # legitimate checkpoint heights are always in flight.
        expr: |
          max(
            count by (checkpoint_height) (
              count_values by (checkpoint_height) ("fp", pivxd_checkpoint_fingerprint)
            )
          ) > 1
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "FORK: fleet disagrees on chain history"
          description: >
            Instances report different block hashes below the tip. The fleet is
            split across chains — compare pivxd_checkpoint_fingerprint by
            instance to find which side each node is on.

      - alert: PeerCountTooLow
        expr: pivxd_peer_count < {{ min_peer_count | default(2) }}
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Low peer count on {{ '{{' }} $labels.pivx_instance {{ '}}' }}"
          description: >
            {{ '{{' }} $labels.pivx_instance {{ '}}' }} has
            {{ '{{' }} $value {{ '}}' }} peers, below
            {{ min_peer_count | default(2) }}.

      - alert: PivxInstanceNoInbound
        # A masternode nobody can dial still looks healthy on every other
        # metric — that is what silently broke the Tor cohort. Scoped to
        # MN-capable instances only: v4-mn02 and the observer legitimately have
        # no inbound and would otherwise fire forever.
        #
        # Measured per cohort as a share rather than per instance. Only one
        # outbound per netgroup is permitted (net.cpp:1807) and the 45 IPv4
        # addresses sit in 10 netgroups, 18 of them in 51.161.0.0/16 alone, so
        # inside a crowded group one instance takes the slot and the others get
        # no inbound however reachable they are. The six firing this way all
        # answered a TCP connect from outside their own netgroup, so the
        # per-instance form was reporting correct topology as a fault, and an
        # alert that is always on is one nobody reads.
        #
        # A cohort losing reachability outright is the case worth paging on,
        # which is what happened to Tor, and it shows up as most of a cohort at
        # once: 6 of 45 IPv4 is the netgroup limit, 50 of 50 Tor was a fault.
        expr: |
          (
            count by (cohort) (
              pivxd_peers_inbound == 0 and on(pivx_instance) pivxd_up{mn_capable="1"} == 1
            )
            /
            count by (cohort) (pivxd_up{mn_capable="1"} == 1)
          ) > 0.5
        for: 30m
        labels:
          severity: warning
        annotations:
          summary: "{{ '{{' }} $labels.cohort {{ '}}' }} cohort is mostly unreachable"
          description: >
            Over half the MN-capable {{ '{{' }} $labels.cohort {{ '}}' }}
            instances have had zero inbound for 30m. A few is the netgroup limit
            and expected; a cohort-wide figure means the advertised address, port
            or hidden service is broken for that whole class.

      - alert: PivxStuckInIBD
        expr: pivxd_ibd == 1
        for: 60m
        labels:
          severity: warning
        annotations:
          summary: "{{ '{{' }} $labels.pivx_instance {{ '}}' }} stuck in initial block download"
          description: >
            IBD suppresses address gossip, so an instance parked here stops
            advertising itself and its addrman goes stale.

      - alert: PivxBansClimbing
        expr: pivxd_banned_peers > 5
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "{{ '{{' }} $labels.pivx_instance {{ '}}' }} is banning peers"
          description: >
            {{ '{{' }} $value {{ '}}' }} bans. Fleet nodes banning each other
            usually means a misbehaviour loop, not hostile peers.

      - alert: AllTorInstancesDown
        expr: count(pivxd_up{cohort="tor"} == 0) == count(pivxd_up{cohort="tor"})
        for: 2m
        labels:
          severity: critical
          cohort: tor
        annotations:
          summary: "ALL Tor masternode instances are down"
          description: "The entire Tor cohort has gone offline. Quorum will degrade."

      - alert: AllIPv6InstancesDown
        expr: count(pivxd_up{cohort="ipv6"} == 0) == count(pivxd_up{cohort="ipv6"})
        for: 2m
        labels:
          severity: critical
          cohort: ipv6
        annotations:
          summary: "ALL IPv6 masternode instances are down"
          description: "The entire IPv6 cohort has gone offline. Quorum will degrade."

      - alert: CohortBelowQuorumMinSize
        # llmq_50_60 needs minSize members to run a DKG at all. Below this a
        # cohort-isolated quorum cannot form, which is the whole point of the
        # cohort sizing work.
        expr: count by (cohort) (pivxd_up == 1) < {{ llmq_min_size | default(40) }}
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Cohort {{ '{{' }} $labels.cohort {{ '}}' }} below LLMQ minSize"
          description: >
            {{ '{{' }} $value {{ '}}' }} live instances in
            {{ '{{' }} $labels.cohort {{ '}}' }}, under the
            {{ llmq_min_size | default(40) }} a DKG needs.

      - alert: SupplyDisagreement
        # Nodes at the same supply-index height must report identical supply.
        # Disagreement there is a consensus bug, not a reporting lag — which is
        # why the index-height stddev has to be zero for this to fire.
        expr: stddev(pivxd_supply_total) > 0 and stddev(pivxd_supply_updateheight) == 0
        for: 10m
        labels:
          severity: critical
        annotations:
          summary: "FLEET DISAGREES ON MONEY SUPPLY"
          description: >
            Instances at the same supply index height report different total
            supply. Compare pivxd_supply_total by instance.

      - alert: UnexpectedIssuance
        # Emission is deterministic through the PoW window. Supply moving while
        # nothing is mining means coin appeared from somewhere it should not.
        expr: |
          rate(pivxd_supply_total[30m]) > 0
          and on() (max(pivxd_block_height) - min(pivxd_block_height offset 30m)) == 0
        for: 15m
        labels:
          severity: critical
        annotations:
          summary: "Supply grew without the chain advancing"
          description: >
            pivxd_supply_total increased over 30m while chain height did not
            move. Investigate before mining further.

      - alert: ProviderMajorityDown
        expr: |
          count(pivxd_up == 0) by (provider)
          / count(pivxd_up) by (provider) > 0.5
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "Majority of {{ '{{' }} $labels.provider {{ '}}' }} PIVX instances are down"
          description: >
            More than 50% of {{ '{{' }} $labels.provider {{ '}}' }} PIVX
            instances are unreachable. Potential provider-level outage.

  - name: bootstrap_mining
    interval: 60s
    rules:

      # PLACEHOLDER: requires custom miner exporter or process check
      - alert: BootstrapMinerDown
        expr: up{job="node_exporter", node_role="bootstrap_miner"} == 0
        for: 3m
        labels:
          severity: critical
          lifecycle_phase: bootstrap_mining
        annotations:
          summary: "Bootstrap miner {{ '{{' }} $labels.instance {{ '}}' }} is down"
          description: >
            A bootstrap miner has been unreachable for >3 minutes.
            Chain progression will slow or stop if all miners go down.

  # ===========================================================================
  # OBSERVABILITY STACK HEALTH
  # ===========================================================================
  - name: monitoring_stack
    interval: 60s
    rules:

      - alert: PrometheusDown
        expr: up{job="prometheus"} == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "Prometheus itself is down"
          description: "Prometheus on {{ monitoring_host }} is not scraping."

      - alert: LokiDown
        expr: up{job="loki"} == 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Loki log aggregation is down"
          description: "Vector agents on fleet hosts cannot ship logs."

      - alert: AlertmanagerDown
        expr: up{job="alertmanager"} == 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Alertmanager is down — alerts will not route"
          description: "Alertmanager on {{ monitoring_host }} is not responding."

      # --- Consensus changeover -------------------------------------------
      # The PoW->PoS handover at {{ mining_phase_target_height }} and the v6
      # handover at {{ v6_activation_height }} are the two points where the
      # chain can stop and not restart on its own. Fire on what the node
      # reports rather than on a height guess, and page loudly at the moment
      # of transition because both need a human.

      - alert: ChainTipStale
        # UpdateBlockchainSynced flips a node to unsynced at 3600s, and an
        # unsynced node stops sending masternode pings, so the whole tier two
        # expires. Fire well before that so there is time to react.
        #
        # Staking settled at a steady 15s spacing once PoS activated, so 300s
        # is already 20 missed blocks and means the stakers have stopped, not
        # that one block ran late. The old 2400 was sized for the keepalive
        # cadence during PoW and would have let the chain sit dead for 160
        # blocks before firing.
        expr: |
          min(pivxd_tip_age_seconds) > 300
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Chain tip is {{ '{{' }} $value | humanizeDuration {{ '}}' }} old"
          description: >
            No new block fleet-wide. At 3600s every node marks itself unsynced,
            masternode pings stop and the registrations expire. Below
            {{ mining_phase_target_height }} check the keepalive cron on the
            mining host; above it the chain is failing to stake.

      - alert: PowPhaseEnding
        expr: |
          max(pivxd_block_height) >= {{ mining_phase_target_height | int - 11 }}
            and max(pivxd_upgrade_active{upgrade="PoS"}) == 0
        for: 1m
        labels:
          severity: warning
        annotations:
          summary: "Within 10 blocks of the PoS changeover"
          description: >
            Height {{ '{{' }} $value {{ '}}' }}. PoW stops at
            {{ mining_phase_target_height | int - 1 }} and block
            {{ mining_phase_target_height }} must be staked. Confirm the seeder
            wallet has stakeablecoins > 0 before it gets there.

      - alert: PosTransitionStalled
        # The dangerous window: PoW has stopped and nothing has staked yet.
        expr: |
          max(pivxd_block_height) >= {{ mining_phase_target_height | int - 1 }}
            and max(pivxd_upgrade_active{upgrade="PoS"}) == 0
            and min(pivxd_tip_age_seconds) > 900
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "PoW ended, first PoS block has not arrived"
          description: >
            The chain is parked at the PoS boundary with a
            {{ '{{' }} $value | humanizeDuration {{ '}}' }} old tip and nothing
            is staking. Masternodes expire once the tip passes 3600s. Check
            staking=1 and stakeablecoins on the seeder wallet.

      - alert: PosActivated
        expr: |
          max(pivxd_upgrade_active{upgrade="PoS"}) == 1
        for: 1m
        labels:
          severity: info
        annotations:
          summary: "PoS is active — the chain is staking"
          description: >
            UPGRADE_POS reported active by the fleet. PoW is finished and the
            keepalive cron is no longer doing anything. Confirm blocks keep
            arriving before standing down.

      - alert: UpgradeActivated
        # One rule instead of thirteen. The upgrade label says which one, so
        # the notification names itself. Fires on the edge: active now, pending
        # 15 minutes ago. At 15s spacing that window is 60 blocks, wide enough
        # that a scrape gap cannot hide the transition and narrow enough that
        # it stops firing afterwards.
        expr: |
          max by (upgrade, activation_height) (pivxd_upgrade_active) == 1
            and max by (upgrade, activation_height) (pivxd_upgrade_active offset 15m) == 0
        for: 1m
        labels:
          severity: info
        annotations:
          summary: "{{ '{{' }} $labels.upgrade {{ '}}' }} activated at height {{ '{{' }} $labels.activation_height {{ '}}' }}"
          description: >
            The staged activations between PoS and v6 are consensus only and
            need no action. Worth watching ChainForkDetected and the masternode
            count for a few minutes after each one in case a node disagrees.

      - alert: V6ActivationApproaching
        expr: |
          max(pivxd_block_height) >= {{ v6_activation_height | int - 50 }}
            and max(pivxd_upgrade_active{upgrade="v6_evo"}) == 0
        for: 1m
        labels:
          severity: warning
        annotations:
          summary: "Within 50 blocks of v6 activation"
          description: >
            Legacy masternodes go obsolete at {{ v6_activation_height }} and
            special transactions become valid. Any node with a stale evoDB
            aborts with "Found EvoDB inconsistency, you must reindex". The
            ProRegTx wave has to be ready to fire.

      - alert: V6Activated
        expr: |
          max(pivxd_upgrade_active{upgrade="v6_evo"}) == 1
        for: 1m
        labels:
          severity: info
        annotations:
          summary: "v6 is active — legacy masternodes are now obsolete"
          description: >
            Deterministic masternodes only from here. Expect the legacy count
            to fall to zero; anything not re-registered by ProRegTx is gone.

      - alert: MasternodeCountDropping
        # Expiry from a stalled chain shows up here first.
        expr: |
          max(pivxd_masternode_count{state="enabled"})
            < max_over_time(pivxd_masternode_count{state="enabled"}[6h]) * 0.9
        for: 10m
        labels:
          severity: critical
        annotations:
          summary: "Enabled masternodes down >10% from the 6h peak"
          description: >
            {{ '{{' }} $value {{ '}}' }} enabled now. A stalled tip stops pings
            and expires registrations fleet-wide; check ChainTipStale first.
