#!/usr/bin/env python3
"""Export PIVX chain state as Prometheus metrics via the node_exporter textfile
collector.

Deliberately NOT a network service: it writes a .prom file that node_exporter
already serves on 9100. No extra port, no ufw rule, and none of the firewall
allowlist traps that come with adding a scrape target.

Label choice matters. Prometheus sets instance=<hostname> on every
node_exporter target, so emitting our own `instance` label would collide and be
renamed to exported_instance. The pivxd instance is therefore `pivx_instance`,
leaving host/provider/chain to arrive from the target labels.

Instance metadata is baked in at deploy time from host_vars rather than guessed
from paths, so cohort/protocol_class always match what the inventory says.

Generated by Ansible for {{ inventory_hostname }} — do not edit on the host.

Note for editors: the Python below sits inside a Jinja raw block, because the
doubled curly braces needed to emit Prometheus label sets are otherwise parsed
as Jinja expressions. Templated values are all defined above that block.
"""
import json
import os
import subprocess
import sys
import tempfile
import time

CLI = "/opt/pivx/current/bin/pivx-cli"
OUT = "{{ pivx_metrics_textfile_dir }}/pivx.prom"
TIMEOUT = {{ pivx_metrics_rpc_timeout | default(15) }}
# Depth below the tip used for the fork-detection fingerprint. The tip itself is
# useless for comparing across the fleet: nodes legitimately differ by a block
# or two while a new block propagates, which would look like a permanent fork.
# A checkpoint this far back is stable unless there is a genuine deep reorg.
CHECKPOINT_DEPTH = {{ pivx_metrics_checkpoint_depth | default(10) }}
# Checkpoints are snapped to a multiple of this so the whole fleet picks the
# same block even while heights differ by a block or two.
CHECKPOINT_STRIDE = {{ pivx_metrics_checkpoint_stride | default(10) }}

# Only the fields this script needs. The full instance dicts carry
# rpc_password from the vault and this file is world-readable, so never dump
# them wholesale. pivx-cli reads the credentials from pivx.conf itself.
#
# mn_capable is computed here rather than counted in PromQL, because a cohort's
# instance count is NOT its usable masternode count: CheckDefaultPort rejects
# any masternode not announcing the network default port, so v4-mn02 (sharing
# its host IP on another port) and the seeder/observer instances are in the
# ipv4 cohort but can never be masternodes. Counting instances would overstate
# every cohort against the LLMQ minSize.
INSTANCES = {i["name"]: i for i in json.loads(r"""
[
{% for i in pivx_instances | selectattr('enabled', 'equalto', true) %}
{% set capable = 1 if ((i.protocol_class == 'tor' and (i.onion_address | default('')) != '')
                       or (i.protocol_class != 'tor' and i.p2p_port == pivx_p2p_port_base))
                 else 0 %}
  {"name": "{{ i.name }}",
   "confdir": "{{ i.confdir }}",
   "cohort": "{{ i.cohort }}",
   "protocol_class": "{{ i.protocol_class }}",
   "mn_capable": "{{ capable }}",
   "role": "{{ i.role }}"}{% if not loop.last %},{% endif %}

{% endfor %}
]
""")}

{% raw %}

def rpc(conf, *args):
    """Run a pivx-cli call, returning parsed JSON, a scalar, or None."""
    try:
        p = subprocess.run([CLI, f"-conf={conf}", *args],
                           capture_output=True, text=True, timeout=TIMEOUT)
    except (subprocess.TimeoutExpired, OSError):
        return None
    if p.returncode != 0:
        return None
    out = p.stdout.strip()
    if not out:
        return None
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        return out


def fingerprint(block_hash):
    """Hash -> float64-safe integer.

    Only the low 13 hex digits (52 bits) are used: Prometheus stores samples as
    float64, whose mantissa is 53 bits, so a longer slice would silently lose
    precision and make distinct chains compare equal.
    """
    if not block_hash or not isinstance(block_hash, str):
        return None
    try:
        return int(block_hash[-13:], 16)
    except ValueError:
        return None


def collect(name, meta):
    conf = meta["confdir"] + "/pivx.conf"
    labels = {
        "pivx_instance": name,
        "cohort": meta.get("cohort", "unknown"),
        "protocol_class": meta.get("protocol_class", "unknown"),
        "mn_capable": meta.get("mn_capable", "0"),
        "mn_role": meta.get("role", "unknown"),
    }
    m = []

    def add(metric, value, extra=None):
        if value is None:
            return
        lab = dict(labels)
        if extra:
            lab.update(extra)
        tags = ",".join('%s="%s"' % (k, v) for k, v in lab.items())
        m.append("%s{%s} %s" % (metric, tags, value))

    chain = rpc(conf, "getblockchaininfo")
    if not isinstance(chain, dict):
        add("pivxd_up", 0)
        return m
    add("pivxd_up", 1)

    height = chain.get("blocks")
    add("pivxd_block_height", height)
    add("pivxd_header_height", chain.get("headers"))
    add("pivxd_verification_progress", chain.get("verificationprogress"))
    add("pivxd_difficulty", chain.get("difficulty"))
    add("pivxd_ibd", 1 if chain.get("initial_block_downloading") else 0)
    add("pivxd_tip_fingerprint", fingerprint(chain.get("bestblockhash")))

    # UpdateBlockchainSynced marks a node unsynced once the tip passes 60
    # minutes, and an unsynced node stops sending masternode pings, so a stalled
    # chain expires every registration. Nothing produces blocks on its own below
    # the PoS activation height, so this has to be watched.
    # getblockchaininfo carries no mediantime on this build, so read the tip.
    tip_hash = chain.get("bestblockhash")
    if tip_hash:
        tip = rpc(conf, "getblock", tip_hash)
        if isinstance(tip, dict) and isinstance(tip.get("time"), int):
            add("pivxd_tip_age_seconds", int(time.time()) - tip["time"])

    # Activation state read from the node instead of inferred from height, so
    # the alert fires on what consensus did rather than on a height guess.
    # status is "active" or "pending". The activation height goes on a label.
    ups = chain.get("upgrades")
    if isinstance(ups, dict):
        for name, u in ups.items():
            if not isinstance(u, dict):
                continue
            add("pivxd_upgrade_active",
                1 if u.get("status") == "active" else 0,
                {"upgrade": name.replace(" ", "_"),
                 "activation_height": str(u.get("activationheight", ""))})

    # Fork detection needs every node to fingerprint the SAME block. Taking it
    # at (own height - depth) does not: nodes one or two blocks apart during
    # normal propagation hash different blocks and look like separate chains,
    # which reported 3 chains on a fleet that was provably in consensus.
    #
    # So round down to a multiple of CHECKPOINT_STRIDE first, then back off.
    # Nodes within a stride of each other pick the identical height, and the
    # height travels as a label so PromQL only ever compares like with like.
    if isinstance(height, int) and height > CHECKPOINT_STRIDE + CHECKPOINT_DEPTH:
        cp = ((height // CHECKPOINT_STRIDE) * CHECKPOINT_STRIDE) - CHECKPOINT_DEPTH
        h = rpc(conf, "getblockhash", str(cp))
        add("pivxd_checkpoint_fingerprint", fingerprint(h),
            {"checkpoint_height": str(cp)})
        add("pivxd_checkpoint_height", cp)

    peers = rpc(conf, "getpeerinfo")
    if isinstance(peers, list):
        inbound = sum(1 for p in peers if p.get("inbound"))
        add("pivxd_peer_count", len(peers))
        add("pivxd_peers_inbound", inbound)
        add("pivxd_peers_outbound", len(peers) - inbound)
        # Ping is the only latency signal available for free, and it is what
        # will matter when DKG timing gets measured across cohorts.
        pings = [p["pingtime"] for p in peers
                 if isinstance(p.get("pingtime"), (int, float))]
        if pings:
            add("pivxd_peer_ping_seconds_avg", round(sum(pings) / len(pings), 6))
            add("pivxd_peer_ping_seconds_max", round(max(pings), 6))

    mp = rpc(conf, "getmempoolinfo")
    if isinstance(mp, dict):
        add("pivxd_mempool_txcount", mp.get("size"))
        add("pivxd_mempool_bytes", mp.get("bytes"))

    # Money supply. Called WITHOUT force_update: forcing a recalculation walks
    # the UTXO set, which is far too expensive to do every 60s on every
    # instance. The cached index lags the tip, sometimes by a lot, so
    # updateheight is exported alongside — a supply figure is meaningless
    # without knowing which height it describes.
    #
    # Emission here is deterministic (60001 in block 1, then 250000/block
    # through the PoW window), so supply that does not match expectation, or
    # that differs between nodes at the same updateheight, is a consensus bug
    # rather than a reporting quirk.
    supply = rpc(conf, "getsupplyinfo")
    if isinstance(supply, dict):
        add("pivxd_supply_total", supply.get("totalsupply"))
        add("pivxd_supply_transparent", supply.get("transparentsupply"))
        add("pivxd_supply_shield", supply.get("shieldsupply"))
        uh = supply.get("updateheight")
        add("pivxd_supply_updateheight", uh)
        if isinstance(uh, int) and isinstance(height, int):
            add("pivxd_supply_index_lag", height - uh)

    banned = rpc(conf, "listbanned")
    if isinstance(banned, list):
        add("pivxd_banned_peers", len(banned))

    wallet = rpc(conf, "getwalletinfo")
    if isinstance(wallet, dict):
        add("pivxd_wallet_balance", wallet.get("balance"))
        add("pivxd_wallet_immature", wallet.get("immature_balance"))
        add("pivxd_wallet_txcount", wallet.get("txcount"))

    mn = rpc(conf, "getmasternodecount")
    if isinstance(mn, dict):
        for k in ("total", "stable", "enabled", "inqueue", "ipv4", "ipv6", "onion"):
            add("pivxd_masternode_count", mn.get(k), {"state": k})

    return m


def main():
    start = time.time()
    lines = [
        "# HELP pivxd_up Whether the instance answered getblockchaininfo.",
        "# TYPE pivxd_up gauge",
        "# HELP pivxd_block_height Current chain height.",
        "# TYPE pivxd_block_height gauge",
        "# HELP pivxd_checkpoint_fingerprint Low 52 bits of the block hash "
        "below the tip; differing values across the fleet mean a fork.",
        "# TYPE pivxd_checkpoint_fingerprint gauge",
        "# HELP pivxd_peer_count Connected peers.",
        "# TYPE pivxd_peer_count gauge",
        "# HELP pivxd_tip_age_seconds Seconds since the tip block's timestamp. "
        "Past 3600 a node stops sending masternode pings.",
        "# TYPE pivxd_tip_age_seconds gauge",
        "# HELP pivxd_upgrade_active 1 when the node reports the upgrade "
        "active, 0 while pending.",
        "# TYPE pivxd_upgrade_active gauge",
    ]
    for name, meta in sorted(INSTANCES.items()):
        try:
            lines += collect(name, meta)
        except Exception as e:                       # never let one instance
            print("%s: %s" % (name, e), file=sys.stderr)   # break the export
            lines.append('pivxd_up{pivx_instance="%s"} 0' % name)

    lines.append("pivxd_scrape_duration_seconds %s" % round(time.time() - start, 3))
    lines.append("pivxd_scrape_timestamp %d" % int(time.time()))

    # Atomic replace: node_exporter reads this file on its own schedule and a
    # partial write would surface as malformed metrics.
    d = os.path.dirname(OUT)
    with tempfile.NamedTemporaryFile("w", dir=d, delete=False) as f:
        f.write("\n".join(lines) + "\n")
        tmp = f.name
    os.chmod(tmp, 0o644)
    os.replace(tmp, OUT)


if __name__ == "__main__":
    main()
{% endraw %}
