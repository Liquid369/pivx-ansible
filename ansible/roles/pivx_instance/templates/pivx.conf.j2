# pivx.conf — {{ instance.name }}
# Generated by Ansible. Do NOT edit manually — changes will be overwritten on next deploy.
#
# Host:           {{ inventory_hostname }}
# Provider:       {{ provider }}
# Role:           {{ instance.role }}
# Protocol:       {{ instance.protocol_class }}
# Cohort:         {{ instance.cohort }}
# Lifecycle:      {{ lifecycle_phase }}
#
# To regenerate: make deploy-pivx LIMIT={{ inventory_hostname }}

# =============================================================================
# NETWORK SELECTION
# =============================================================================
testnet=1

# IMPORTANT: everything below lives in the [test] section. This build gates
# addnode/connect/port/bind/rpcport/rpcbind/wallet to the active network
# section (util/system.cpp m_network_only_args) — values for those keys in
# the global section are silently IGNORED when testnet=1.
[test]

# =============================================================================
# GENERAL
# =============================================================================
maxconnections={{ 256 if instance.role == 'seeder' else (pivx_maxconnections | default(125)) }}
printtoconsole={{ pivx_printtoconsole | default(1) }}

# The legacy masternode sync asks peers for the list with `dseg`, and a peer
# that asks twice is scored +20 ("dseg - peer already asked me for the list").
# With no masternodes registered yet, CMasternodeSync never completes, so it
# keeps re-asking and five retries reach the default banscore of 100. The whole
# fleet banned each other within minutes of leaving IBD — 376 bans across 15
# hosts — which strands clearnet instances at 0 peers and stops them syncing.
#
# Every node here is ours, so scoring them as hostile buys nothing. Raise the
# threshold well above what the dseg loop can accumulate. Drop this back toward
# the default once DMNs are registered and the sync actually completes, since
# real banning is worth having when the network is public.
banscore={{ pivx_banscore | default(10000) }}

# Sapling zk-SNARK parameters. Kept outside /home because the systemd unit
# uses ProtectHome=true.
paramsdir={{ pivx_params_dir }}

{% if instance.protocol_class == 'ipv4' %}
# --- IPv4 mode ---
listen=1
bind={{ instance.bind_addr }}
externalip={{ instance.external_ip }}
{% elif instance.protocol_class == 'ipv6' %}
# --- IPv6 mode ---
listen=1
bind={{ instance.bind_addr }}
externalip={{ instance.external_ip }}
onlynet=ipv6
{% elif instance.protocol_class == 'tor' %}
# --- Tor-only mode ---
# Binds on loopback; all traffic routed through Tor SOCKS proxy.
# External address is the hidden service .onion from Tor.
listen=1
bind=127.0.0.1
proxy=127.0.0.1:{{ tor_socks_port | default(9050) }}
onlynet=onion
{% if instance.onion_address | default('') != '' %}
# Advertise the hidden service's PUBLIC port, not the local one below. The
# torrc maps {{ pivx_p2p_port_base }} -> this instance's local port, so peers
# must dial {{ pivx_p2p_port_base }}. Advertising the local port instead gets
# every dial refused, and pivxd retries hard enough to burn a whole core.
# Masternodes must announce {{ pivx_p2p_port_base }} anyway (masternode.cpp
# CheckDefaultPort), so this is the same value either way.
externalip={{ instance.onion_address }}:{{ pivx_p2p_port_base }}
{% else %}
# externalip= not set — run `make deploy-tor` first and fill onion_address in host_vars
{% endif %}
{% endif %}

port={{ instance.p2p_port }}

# =============================================================================
# SEED / ADDNODE
# Only tor instances get the onion seeds. A clearnet instance has no SOCKS
# proxy, so dialling an onion fails with "Cannot create socket: unsupported
# network" on every retry and burns an outbound slot for nothing.
#
# A seed must never addnode itself. pivxd dials the address, spots its own
# nonce in the VERSION handshake, drops the connection, and ThreadOpenAdded-
# Connections retries it forever. On clearnet that is a cheap loopback connect,
# but over Tor every retry builds a fresh 3-hop circuit: the three onion seeds
# were spending ~88% of their CPU in b-pivx-addcon doing exactly this.
# =============================================================================
{% if instance.protocol_class == 'tor' %}
{%   set self_addr = (instance.onion_address | default('')) ~ ':' ~ pivx_p2p_port_base %}
{% elif instance.protocol_class == 'ipv6' %}
{%   set self_addr = '[' ~ instance.external_ip ~ ']:' ~ instance.p2p_port %}
{% else %}
{%   set self_addr = instance.external_ip ~ ':' ~ instance.p2p_port %}
{% endif %}
{% for seed in pivx_seed_nodes | default([]) %}
{% if ('.onion' not in seed or instance.protocol_class == 'tor') and seed != self_addr %}
addnode={{ seed }}
{% endif %}
{% endfor %}

# =============================================================================
# RPC
# Bound to localhost only. Remote monitoring uses SSH tunnel if needed.
# =============================================================================
server=1
rpcuser={{ instance.rpc_user }}
rpcpassword={{ instance.rpc_password }}
rpcport={{ instance.rpc_port }}
rpcbind=127.0.0.1
rpcallowip=127.0.0.1

# =============================================================================
# DATA / LOGGING
# =============================================================================
datadir={{ instance.datadir }}
debuglogfile={{ instance.logdir }}/debug.log

{% for cat in pivx_debug_categories | default(['net']) %}
debug={{ cat }}
{% endfor %}

# =============================================================================
# LIFECYCLE PHASE: {{ lifecycle_phase }}
# =============================================================================

# Bootstrap mining is driven by generatetoaddress from
# make start-bootstrap-mining, not by the background miner thread. gen=1 would
# have both running at once on the same instance, racing for the same height.
# It is also the loop that filled the seeder disks before the miner fix.
gen=0

{% if instance.staking_enabled | default(false) %}
# --- Phase 3+: Staking enabled ---
staking=1
{% else %}
staking=0
{% endif %}

{% if (instance.masternode_enabled | default(false)) and instance.role == 'masternode' %}
{% set mn_mode = instance.mn_mode | default(masternode_mode) | default('deterministic') %}
# --- Masternode enabled ({{ mn_mode }}) ---
# Special transactions are rejected until UPGRADE_V6_0 (block 5000), and
# legacy masternodes go obsolete at the same height. So a masternode runs
# legacy first, then re-registers as deterministic once v6 is live. Flip
# mn_mode on the instance (or masternode_mode fleet-wide) at the cutover.
masternode=1
{% if mn_mode == 'legacy' %}
{# Key comes from the vault keyed by instance name, so 74 keys do not have to
   be pasted into host_vars. A per-instance mn_legacy_privkey still wins if set,
   which keeps one-off overrides possible. Generate with
   make generate-mn-keys, then merge the result into group_vars/all/vault.yml. #}
{% set legacy_key = instance.mn_legacy_privkey | default('') %}
{% if legacy_key in ['', 'REPLACE_ME'] %}
{%   set legacy_key = (vault_mn_legacy_keys | default({})).get(instance.name, '') %}
{% endif %}
{% if legacy_key not in ['', 'REPLACE_ME'] %}
masternodeprivkey={{ legacy_key }}
{% else %}
# masternodeprivkey= not set — run `make generate-mn-keys` and merge the output
# into group_vars/all/vault.yml as vault_mn_legacy_keys
{% endif %}
{% else %}
{% if instance.bls_operator_key | default('') not in ['', 'REPLACE_ME'] %}
mnoperatorprivatekey={{ instance.bls_operator_key }}
{% else %}
# mnoperatorprivatekey= not set — generate with `pivx-cli generateblskeypair`
# and fill bls_operator_key in host_vars!
{% endif %}
{% endif %}
{% endif %}

# =============================================================================
# ROLE-SPECIFIC SETTINGS
# =============================================================================
{% if instance.role == 'seeder' %}
# Seeder node — high connection count (maxconnections set above),
# no masternode behavior.
{% elif instance.role == 'observer' %}
# Observer node — reads blockchain, does not participate in consensus.
# (No addressindex option exists in this build; txindex only.)
txindex=1
{% endif %}

# =============================================================================
# INSTANCE-SPECIFIC EXTRAS
# These lines come from instance.extra_conf in host_vars.
# =============================================================================
{% for line in instance.extra_conf | default([], true) %}
{{ line }}
{% endfor %}
